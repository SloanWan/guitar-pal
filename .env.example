# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Enables /dev; never in production
# NEXT_PUBLIC_ENABLE_DEV_ROUTES=1

# Assistant General mode; deepseek-* models use DEEPSEEK_API_KEY, claude-* use ANTHROPIC_API_KEY
# ASSISTANT_MODEL=deepseek-flash
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# Book import (book-service/README.md); /books reports it as not configured without these
# BOOK_SERVICE_URL=http://localhost:8000
# BOOK_SERVICE_DATABASE_URL=
# BOOK_SERVICE_INTERNAL_SECRET=
# BOOK_SERVICE_VALIDATE_URL=http://localhost:3000
# SUPABASE_JWT_SECRET=

# E2E tests: see e2e/README.md
