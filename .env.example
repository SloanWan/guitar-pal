# Supabase (required) — from your project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Enables the /dev tool area (dashboard, session, auditions, labs).
# MUST be unset (or not "1") in production.
NEXT_PUBLIC_ENABLE_DEV_ROUTES=1

# Strum assistant (optional). Without it the assistant still reads typed chords
# and rhythms; only the natural-language path is disabled.
# Server-side only — never expose this as NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# Book import (optional) — the Python service in book-service/. Without these
# the /books pages report the feature as not configured. In docker-compose the
# same .env feeds both containers; for `npm run dev` point BOOK_SERVICE_URL at
# a locally running `uvicorn` (see book-service/README.md).
BOOK_SERVICE_URL=http://localhost:8000
BOOK_SERVICE_DATABASE_URL=postgresql://book_service:<password>@<pooler-host>:6543/postgres
# Shared between Next.js and the book service: the book service validates the
# drafts it extracts through Next.js's internal endpoint, and this is what
# lets it in. Any long random string (e.g. `openssl rand -hex 32`).
BOOK_SERVICE_INTERNAL_SECRET=
# Where the book service finds that endpoint. docker-compose sets it to
# http://web:3000; for `npm run dev:books` beside `npm run dev` use the dev
# server's own port.
BOOK_SERVICE_VALIDATE_URL=http://localhost:3000
# Legacy projects only (shared HS256 secret); leave unset on asymmetric signing keys.
# SUPABASE_JWT_SECRET=
# OCR for scanned uploads. The Docker image carries the Tesseract data and sets
# TESSDATA_PREFIX itself; for `uvicorn` on your machine run
# book-service/tools/fetch-tessdata.sh and point at its folder.
# TESSDATA_PREFIX=book-service/tessdata
# BOOK_SERVICE_OCR_LANGUAGES=chi_sim+eng
