<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guitarpal.api.visits.VisitMapper">

	<!-- A record has no setters, so MyBatis fills it through its constructor, in order. -->
	<resultMap id="visit" type="com.guitarpal.api.visits.Visit">
		<constructor>
			<arg column="kind" javaType="string"/>
			<arg column="target" javaType="string"/>
			<arg column="count" javaType="_int"/>
			<arg column="last_at" javaType="java.time.OffsetDateTime"/>
		</constructor>
	</resultMap>

	<!-- #{} binds a parameter, never splices text, so nothing in it can change the SQL.
	     user_visits_top_idx (user_id, count desc, last_at desc) serves this as written. -->
	<select id="findTopByUser" resultMap="visit">
		select kind, target, count, last_at
		from public.user_visits
		where user_id = #{userId}
		order by count desc, last_at desc
		limit #{limit}
	</select>
</mapper>
